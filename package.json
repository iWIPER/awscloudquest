{
  "name": "aws-cloud-quest",
  "version": "3.0.0",
  "private": true,
  "description": "Real-time quiz game to practice for AWS certifications. Plain HTML/CSS/JS, no build step.",
  "license": "MIT",
  "author": "Wilk Pereira Cosentino (https://github.com/iWIPER)",
  "keywords": ["aws", "quiz", "game", "cloud-practitioner", "clf-c02", "study", "github-pages"],
  "repository": {
    "type": "git",
    "url": "https://github.com/iWIPER/awscloudquest.git"
  },
  "homepage": "https://iwiper.github.io/awscloudquest/",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "validate": "node scripts/validate-questions.mjs",
    "check": "node scripts/check-syntax.mjs",
    "import": "node scripts/import-questions.mjs",
    "serve": "node scripts/serve.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:duel": "node scripts/duel-smoke.mjs",
    "assets": "node scripts/build-assets.mjs",
    "ci": "npm run check && npm run validate && npm test"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
